{
  "name": "pinball-trainer",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@^1.4.15",
    "workbox-build": {
      "source-map": "0.7.4"
    },
    "chrome-launcher": "^1.2.1",
    "tmp": "^0.2.4",
    "lighthouse": "^13.0.1",
    "minimatch": "3.1.5",
    "eslint-plugin-sonarjs": {
      "minimatch": "10.2.4"
    },
    "@vitest/ui": {
      "flatted": "3.4.2"
    },
    "serialize-javascript": "^7.0.5",
    "basic-ftp": "^5.3.1",
    "typescript": "6.0.3",
    "uuid": "^11.1.1",
    "ws@7.5.10": "7.5.13",
    "brace-expansion@<1.1.18": "1.1.18",
    "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
    "js-yaml@<3.15.1": "3.15.1",
    "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
    "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
    "ip-address@<=10.3.0": "10.5.0"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all",
    "last 2 versions",
    "Firefox ESR"
  ],
  "scripts": {
    "postinstall": "node scripts/patch-chrome-launcher.cjs && npx --yes playwright install --with-deps",
    "dev": "vite --config config/vite.config.js",
    "prebuild": "node config/generate-sitemap.js",
    "build": "vite build --config config/vite.config.js",
    "build:standalone": "node config/build-standalone-complete.js",
    "analyze": "vite build --config config/vite.config.js && start dist/stats.html",
    "lint": "eslint . --config config/eslint.config.js --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sitemap": "node config/generate-sitemap.js",
    "test": "vitest --config config/vite.config.js",
    "test:ui": "vitest --ui --config config/vite.config.js",
    "test:run": "vitest run --config config/vite.config.js",
    "test:a11y": "vitest run --config config/vite.config.js tests/vitest/a11y",
    "test:coverage": "vitest run --coverage --config config/vite.config.js",
    "test:coverage:ui": "vitest --ui --coverage --config config/vite.config.js",
    "test:e2e": "playwright test --config config/playwright.config.js",
    "test:e2e:a11y": "playwright test --config config/playwright.config.js tests/e2e/accessibility.spec.js",
    "test:e2e:visual": "playwright test --config config/playwright.config.js tests/e2e/visual-regression.spec.js",
    "test:e2e:visual:update": "playwright test --config config/playwright.config.js tests/e2e/visual-regression.spec.js --update-snapshots",
    "test:e2e:ui": "playwright test --ui --config config/playwright.config.js",
    "test:e2e:headed": "playwright test --headed --config config/playwright.config.js",
    "test:e2e:debug": "playwright test --debug --config config/playwright.config.js",
    "lhci:mobile": "npx lhci collect --config=config/lighthouse/mobile.config.cjs",
    "lhci:desktop": "npx lhci collect --config=config/lighthouse/desktop.config.cjs",
    "prepare": "husky"
  },
  "dependencies": {
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.0.15",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "fast-check": "^4.9.0",
    "flatted": "^3.4.4",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4.1.13",
    "ts-api-utils": "^2.4.0",
    "undici": "^8.10.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.15"
  }
}
